{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/(.*)",
      "continue": true,
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://ubaxnokpsymfimsrjxvn.supabase.co; media-src 'self' https://ubaxnokpsymfimsrjxvn.supabase.co; connect-src 'self' https://ubaxnokpsymfimsrjxvn.supabase.co wss://ubaxnokpsymfimsrjxvn.supabase.co; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Access-Control-Allow-Origin": "https://advheloisamaximo.vercel.app"
      }
    },
    {
      "src": "/painel",
      "continue": true,
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "src": "/static/(.*)",
      "continue": true,
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(justica.*|marmore.*|Prancheta1\\.jpg|Heloisa\\.webp|og\\.png|conteudo/.*\\.(?:jpg|mp4))",
      "continue": true,
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" }
    },
    { "handle": "filesystem" },
    { "src": "/(sobre|conteudo|atuacao|contato|diagnostico|perguntas|privacidade|termos|painel)/?", "dest": "/$1/index.html" },
    { "src": "/conteudo/[^/]+/?", "dest": "/conteudo/index.html" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
